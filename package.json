{
  "name": "project-espera",
  "version": "1.0.0",
  "description": "Provider-independent personal AI workspace with persistent, user-approved memory, persona, and project context.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neruel/project-espera.git"
  },
  "homepage": "https://project-espera-web.pages.dev",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@espera/server",
    "dev:client": "npm run dev --workspace=@espera/client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm:dev:server\" \"npm:dev:client\"",
    "db:migrate:local": "tsx packages/server/src/db/local-db-cli.ts migrate",
    "db:reset:local": "tsx packages/server/src/db/local-db-cli.ts reset",
    "dev:wrangler": "npm run dev:wrangler --workspace=@espera/server",
    "lint": "node scripts/lint.mjs",
    "build": "npm run build --workspace=@espera/shared && npm run build --workspace=@espera/server && npm run build --workspace=@espera/client",
    "test:production": "node scripts/production-smoke.mjs",
    "test:live": "node scripts/live-provider-smoke.mjs",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.pages.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
